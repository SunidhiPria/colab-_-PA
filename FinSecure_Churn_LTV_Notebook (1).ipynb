      "source": [
        "df = raw.copy()\n",
        "\n",
        "# (a) data-type correction: tenure arrives partly as text such as \"12 months\"\n",
        "n_text_tenure = int(df[\"tenure_months\"].astype(str).str.contains(\"month\").sum())\n",
        "df[\"tenure_months\"] = pd.to_numeric(df[\"tenure_months\"].astype(str).str.extract(r\"(\\d+)\")[0], errors=\"coerce\")\n",
        "\n",
        "# (b) categorical standardisation\n",
        "def clean_age(x):\n",
        "    if pd.isna(x): return np.nan\n",
        "    nums = [t for t in str(x).replace(\"plus\", \"+\").replace(\"to\", \" \").replace(\"-\", \" \").replace(\"+\", \" + \").split() if t.isdigit()]\n",
        "    if \"+\" in str(x).replace(\"plus\", \"+\"): return f\"{nums[0]}+\"\n",
        "    return f\"{nums[0]}-{nums[1]}\"\n",
        "df[\"age_group\"] = df[\"age_group\"].map(clean_age)\n",
        "df[\"income_range\"] = df[\"income_range\"].astype(\"object\").map(lambda x: np.nan if pd.isna(x) else str(x).replace(\"$\", \"\").strip())\n",
        "promo_map = {\"none\": \"None\", \"no offer\": \"None\", \"intro discount\": \"Intro Discount\",\n",
        "             \"loyalty credit\": \"Loyalty Credit\", \"referral bonus\": \"Referral Bonus\"}\n",
        "df[\"promo_offer\"] = df[\"promo_offer\"].astype(str).str.strip().str.lower().map(promo_map)\n",
        "df[\"investment_active\"] = df[\"investment_active\"].astype(str).str.strip().str.lower().map(\n",
        "    {\"yes\": 1, \"y\": 1, \"1\": 1, \"no\": 0, \"n\": 0, \"0\": 0}).astype(int)\n",
        "df[\"churned\"] = df[\"churned\"].astype(str).str.strip().str.lower().map(\n",
        "    {\"churned\": 1, \"cancelled\": 1, \"retained\": 0, \"active\": 0}).astype(int)\n",
        "assert df[[\"promo_offer\", \"churned\", \"investment_active\"]].notna().all().all(), \"unmapped category found\"\n",
        "\n",
        "# (c) implausible values: more than 150 logins per month (5 per day, every day) are treated as entry errors -> missing\n",
        "RESULTS[\"implausible_logins\"] = int((df[\"app_logins_per_month\"] > 150).sum())\n",
        "df.loc[df[\"app_logins_per_month\"] > 150, \"app_logins_per_month\"] = np.nan\n",
        "\n",
        "# (d) duplicates: count before AND after standardisation, then remove\n",
        "dups_after_std = int(df.duplicated().sum())\n",
        "df = df.drop_duplicates().reset_index(drop=True)\n",
        "RESULTS.update(text_tenure_values=n_text_tenure, duplicates_after_standardisation=dups_after_std,\n",
        "               duplicate_ids_after_dedup=int(df.duplicated(\"customer_id\").sum()),\n",
        "               clean_shape=list(df.shape),\n",
        "               missing_after_cleaning={k: int(v) for k, v in df.isna().sum().items() if v > 0})\n",
        "int_cols = [\"transactions_per_month\", \"app_logins_per_month\", \"support_tickets_90d\", \"late_payments_6m\"]\n",
        "print(f\"Text-formatted tenure values converted: {n_text_tenure}\")\n",
        "print(f\"Implausible login counts set to missing: {RESULTS['implausible_logins']}\")\n",
        "print(f\"Duplicate rows removed (exact + format-variant): {dups_after_std}\")\n",
        "print(\"Shape after cleaning:\", df.shape, \"| remaining duplicate IDs:\", RESULTS[\"duplicate_ids_after_dedup\"])\n",
        "print(\"Missing values after cleaning (left for in-pipeline imputation):\", RESULTS[\"missing_after_cleaning\"])\n",
        "assert len(df) >= 50 and len(df) == len(truth)\n",
        "assert df[\"customer_id\"].is_unique\n",
        "# validation: cleaned data should equal the underlying clean simulation wherever values are present\n",
        "chk = df.merge(truth, on=\"customer_id\", suffixes=(\"\", \"_t\"))\n",
        "for c in [\"age_group\", \"income_range\", \"promo_offer\", \"churned\", \"investment_active\", \"tenure_months\"]:\n",
        "    ok = (chk[c].isna() | (chk[c].astype(str) == chk[c + \"_t\"].astype(str))).all()\n",
        "    print(f\"  validation {c}: {'OK' if ok else 'MISMATCH'}\")"
      ]
