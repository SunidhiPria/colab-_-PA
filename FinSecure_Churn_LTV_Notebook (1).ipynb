      "source": [
        "# threshold selection on OOF training predictions (maximise F2); imbalance-handling ablation on the same OOF basis\n",
        "grid_t = np.round(np.arange(0.05, 0.96, 0.01), 2)\n",
        "thr = {}\n",
        "for name in CLF:\n",
        "    f2 = [fbeta_score(y_train, (oof[name] >= t).astype(int), beta=2) for t in grid_t]\n",
        "    thr[name] = float(grid_t[int(np.argmax(f2))])\n",
        "cv_df[\"F2-optimal threshold (OOF)\"] = cv_df[\"Model\"].map(thr)\n",
        "cv_df[\"OOF recall @ threshold\"] = [recall_score(y_train, (oof[m] >= thr[m]).astype(int)) for m in cv_df[\"Model\"]]\n",
        "cv_df[\"OOF precision @ threshold\"] = [precision_score(y_train, (oof[m] >= thr[m]).astype(int)) for m in cv_df[\"Model\"]]\n",
        "cv_df[\"OOF F2 @ threshold\"] = [fbeta_score(y_train, (oof[m] >= thr[m]).astype(int), beta=2) for m in cv_df[\"Model\"]]\n",
        "\n",
        "# ablation: same best hyper-parameters, no class weighting, default 0.5 threshold, OOF basis\n",
        "abl = []\n",
        "for name, (est, grid) in CLF.items():\n",
        "    for cw in [\"balanced\", None]:\n",
        "        p = fitted[name].named_steps[\"clf\"].get_params(); p[\"class_weight\"] = cw\n",
        "        m = Pipeline([(\"pre\", make_pre()), (\"clf\", est.__class__(**p))])\n",
        "        o = cross_val_predict(m, X_train, y_train, cv=cv, method=\"predict_proba\")[:, 1]\n",
        "        abl.append({\"Model\": name, \"Class weight\": \"balanced\" if cw else \"none\", \"OOF recall @0.5\": recall_score(y_train, (o >= .5).astype(int)),\n",
        "                    \"OOF precision @0.5\": precision_score(y_train, (o >= .5).astype(int)), \"OOF average precision\": average_precision_score(y_train, o)})\n",
        "abl_df = pd.DataFrame(abl)\n",
        "display(cv_df.drop(columns=[\"Best hyper-parameters\"]).round(4)); display(abl_df.round(4))\n",
        "cv_df.to_csv(os.path.join(OUT, \"classification_cv_results.csv\"), index=False)\n",
        "abl_df.to_csv(os.path.join(OUT, \"classification_imbalance_ablation.csv\"), index=False)\n",
        "RESULTS[\"cv_table\"] = cv_df.drop(columns=[\"Best hyper-parameters\"]).round(4).to_dict(\"records\")\n",
        "RESULTS[\"ablation\"] = abl_df.round(4).to_dict(\"records\")\n",
        "\n",
        "# model selection: highest OOF average precision (training data only)\n",
        "BEST = cv_df.sort_values(\"OOF average precision\", ascending=False).iloc[0][\"Model\"]\n",
        "RESULTS[\"selected_classifier\"] = BEST; RESULTS[\"thresholds\"] = thr\n",
        "print(\"Selected classifier (highest OOF average precision):\", BEST, \"| F2 threshold:\", thr[BEST])"
      ]
    },
