        "def generate_customers(n=2000, seed=42):\n",
        "    \"\"\"Return a CLEAN simulated customer table (before any messiness is injected).\"\"\"\n",
        "    rng = np.random.default_rng(seed)\n",
        "    sig = lambda x: 1.0 / (1.0 + np.exp(-x))\n",
        "    zs = lambda x: (x - x.mean()) / x.std()\n",
        "\n",
        "    age_levels = [\"18-24\", \"25-34\", \"35-44\", \"45-54\", \"55+\"]\n",
        "    inc_levels = [\"<2k\", \"2k-4k\", \"4k-8k\", \"8k-12k\", \">12k\"]          # monthly income in USD\n",
        "    age = rng.choice(age_levels, n, p=[.12, .32, .27, .18, .11])\n",
        "    inc_idx = rng.choice(5, n, p=[.10, .28, .35, .17, .10])\n",
        "    inc = np.array(inc_levels)[inc_idx]\n",
        "    tenure = np.clip(np.round(rng.gamma(2.0, 6.0, n)), 1, 48).astype(int)\n",
        "\n",
        "    e, f, g = rng.normal(size=(3, n))                                    # latent engagement / frustration / payment stress\n",
        "    logins = rng.poisson(np.exp(2.4 + 0.5 * e))\n",
        "    txn = rng.poisson(np.exp(2.2 + 0.4 * e + 0.12 * (inc_idx - 2)))\n",
        "    tickets = rng.poisson(np.exp(-0.2 + 0.45 * f))\n",
        "    late = np.minimum(rng.poisson(np.exp(-1.1 + 0.6 * g)), 6)\n",
        "    failed = np.minimum(rng.poisson(np.exp(-1.8 + 0.5 * g)), 4)\n",
        "    inv_active = (rng.random(n) < sig(-0.2 + 0.7 * e + 0.3 * (inc_idx - 2))).astype(int)\n",
        "    balance = np.where(inv_active == 1, np.round(rng.lognormal(9.0 + 0.25 * (inc_idx - 2), 1.0), 2), 0.0)\n",
        "    prev = np.minimum(rng.poisson(np.exp(-1.6 + 0.35 * g + 0.2 * f)), 3)\n",
        "\n",
        "    promo = rng.choice([\"None\", \"Intro Discount\", \"Loyalty Credit\", \"Referral Bonus\"], n, p=[.5, .25, .15, .10])\n",
        "    disc = pd.Series(promo).map({\"None\": 0.0, \"Intro Discount\": .30, \"Loyalty Credit\": .15, \"Referral Bonus\": .10}).to_numpy()\n",
        "    fee = np.round(29.0 * (1 - disc), 2)                                 # effective monthly fee (USD)\n",
        "    addon = np.minimum(0.0003 * balance, 40.0)                           # monthly add-on revenue (USD)\n",
        "    hist = np.round(tenure * (fee + addon) * rng.lognormal(0, 0.05, n), 2)   # revenue to date (USD)\n",
        "\n",
        "    es = zs(logins) + zs(txn) + 0.5 * zs(inv_active.astype(float))\n",
        "    q = np.quantile(es, [1 / 3, 2 / 3])\n",
        "    eng = np.where(es < q[0], \"Low\", np.where(es < q[1], \"Medium\", \"High\"))\n",
        "\n",
        "    s = (-1.75 - 0.80 * zs(logins) - 0.30 * zs(txn) + 0.50 * zs(tickets) + 0.45 * zs(late) + 0.30 * zs(failed)\n",
        "         + 0.35 * prev - 0.40 * inv_active - 0.45 * zs(np.log(tenure)) + 0.45 * (tenure <= 3)\n",
        "         + np.select([promo == \"Loyalty Credit\", promo == \"Intro Discount\", promo == \"Referral Bonus\"], [-0.45, 0.25, -0.15], 0.0)\n",
        "         + np.where(age == \"18-24\", 0.30, 0.0) + np.where(age == \"55+\", -0.15, 0.0)\n",
        "         + rng.normal(0, 0.6, n))\n",
        "    p = sig(s)\n",
        "    churn = (rng.random(n) < p).astype(int)                              # cancels within 90 days\n",
        "\n",
        "    h2 = np.clip(0.02 + 0.06 * p, 0, 0.5)                                # monthly hazard in months 4-12 for survivors\n",
        "    extra = np.minimum(rng.geometric(h2) - 1, 9)\n",
        "    months = np.where(churn == 1, rng.uniform(0.5, 3.0, n), 3 + extra)   # months of revenue inside the 12-month window\n",
        "    ltv = np.round(np.maximum(months * (fee + addon) + rng.normal(0, 6, n), 0), 2)\n",
        "\n",
        "    return pd.DataFrame({\n",
        "        \"customer_id\": [f\"CUST-{i:05d}\" for i in range(1, n + 1)],\n",
        "        \"age_group\": age, \"income_range\": inc, \"tenure_months\": tenure,\n",
        "        \"transactions_per_month\": txn, \"app_logins_per_month\": logins,\n",
        "        \"support_tickets_90d\": tickets, \"late_payments_6m\": late, \"failed_payments_6m\": failed,\n",
        "        \"investment_active\": inv_active, \"investment_balance_usd\": balance,\n",
        "        \"prev_cancellations\": prev, \"promo_offer\": promo, \"engagement_level\": eng,\n",
        "        \"effective_monthly_fee_usd\": fee, \"historical_revenue_usd\": hist,\n",
        "        \"churned\": churn, \"ltv_12m_usd\": ltv})\n",
        "\n",
        "truth = generate_customers(2000, SEED)\n",
        "print(\"Clean simulated table:\", truth.shape, \"| churn rate:\", round(truth.churned.mean(), 4))"
      ]
    },
