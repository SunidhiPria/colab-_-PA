      "source": [
        "# ONE final evaluation on the untouched test set\n",
        "test_rows, test_proba, test_pred = [], {}, {}\n",
        "for name in CLF:\n",
        "    pr = fitted[name].predict_proba(X_test)[:, 1]; test_proba[name] = pr\n",
        "    pd_ = (pr >= thr[name]).astype(int); test_pred[name] = pd_\n",
        "    test_rows.append({\"Model\": name, \"Threshold\": thr[name], \"Accuracy\": accuracy_score(y_test, pd_), \"Precision\": precision_score(y_test, pd_),\n",
        "                      \"Recall\": recall_score(y_test, pd_), \"F1-score\": f1_score(y_test, pd_), \"F2-score\": fbeta_score(y_test, pd_, beta=2),\n",
        "                      \"ROC-AUC\": roc_auc_score(y_test, pr), \"Average precision (PR-AUC)\": average_precision_score(y_test, pr)})\n",
        "test_df = pd.DataFrame(test_rows)\n",
        "display(test_df.round(4))\n",
        "test_df.round(4).to_csv(os.path.join(OUT, \"classification_results.csv\"), index=False)\n",
        "RESULTS[\"test_table\"] = test_df.round(4).to_dict(\"records\")\n",
        "RESULTS[\"test_prevalence\"] = float(y_test.mean())\n",
        "\n",
        "# default-threshold view for reference\n",
        "dflt = pd.DataFrame([{\"Model\": n, \"Accuracy@0.5\": accuracy_score(y_test, (test_proba[n] >= .5).astype(int)),\n",
        "                      \"Precision@0.5\": precision_score(y_test, (test_proba[n] >= .5).astype(int)),\n",
        "                      \"Recall@0.5\": recall_score(y_test, (test_proba[n] >= .5).astype(int)),\n",
        "                      \"F1@0.5\": f1_score(y_test, (test_proba[n] >= .5).astype(int))} for n in CLF])\n",
        "display(dflt.round(4)); RESULTS[\"default_threshold_table\"] = dflt.round(4).to_dict(\"records\")\n",
        "\n",
        "for name in CLF:\n",
        "    print(f\"\\n===== {name} (threshold {thr[name]:.2f}) =====\")\n",
        "    print(classification_report(y_test, test_pred[name], target_names=[\"Retained\", \"Churned\"], digits=3))\n",
        "cms = {n: confusion_matrix(y_test, test_pred[n]) for n in CLF}\n",
        "RESULTS[\"confusion\"] = {n: cms[n].tolist() for n in CLF}"
      ]
    },
