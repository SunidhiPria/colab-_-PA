      "source": [
        "X = df[FEATURES].copy(); y = df[\"churned\"].astype(int); y_ltv = df[\"ltv_12m_usd\"]\n",
        "X_train, X_test, y_train, y_test, ltv_train, ltv_test = train_test_split(X, y, y_ltv, test_size=0.2, stratify=y, random_state=SEED)\n",
        "print(f\"Train: {X_train.shape}  churn rate {y_train.mean():.3f} | Test: {X_test.shape}  churn rate {y_test.mean():.3f}\")\n",
        "RESULTS[\"split\"] = {\"n_train\": int(len(X_train)), \"n_test\": int(len(X_test)), \"train_churn\": float(y_train.mean()),\n",
        "                    \"test_churn\": float(y_test.mean()), \"n_train_churn\": int(y_train.sum()), \"n_test_churn\": int(y_test.sum())}\n",
        "\n",
        "NUM_LOG = [\"investment_balance_usd\", \"historical_revenue_usd\"]\n",
        "NUM_STD = [\"tenure_months\", \"transactions_per_month\", \"app_logins_per_month\", \"support_tickets_90d\", \"late_payments_6m\",\n",
        "           \"failed_payments_6m\", \"investment_active\", \"prev_cancellations\", \"effective_monthly_fee_usd\"]\n",
        "CAT = [\"age_group\", \"income_range\", \"promo_offer\", \"engagement_level\"]\n",
        "\n",
        "def make_pre():\n",
        "    return ColumnTransformer([\n",
        "        (\"log\", Pipeline([(\"imp\", SimpleImputer(strategy=\"median\")),\n",
        "                          (\"log\", FunctionTransformer(np.log1p, feature_names_out=\"one-to-one\")),\n",
        "                          (\"sc\", StandardScaler())]), NUM_LOG),\n",
        "        (\"num\", Pipeline([(\"imp\", SimpleImputer(strategy=\"median\")), (\"sc\", StandardScaler())]), NUM_STD),\n",
        "        (\"cat\", Pipeline([(\"imp\", SimpleImputer(strategy=\"most_frequent\")),\n",
        "                          (\"oh\", OneHotEncoder(handle_unknown=\"ignore\"))]), CAT)])\n",
        "\n",
        "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "CLF = {\n",
        " \"Logistic Regression\": (LogisticRegression(max_iter=3000, class_weight=\"balanced\", random_state=SEED), {\"clf__C\": [0.01, 0.1, 1, 10]}),\n",
        " \"Decision Tree\": (DecisionTreeClassifier(class_weight=\"balanced\", random_state=SEED),\n",
        "                   {\"clf__max_depth\": [3, 4, 5, 6, 8], \"clf__min_samples_leaf\": [10, 20, 40]}),\n",
        " \"Random Forest\": (RandomForestClassifier(n_estimators=300, class_weight=\"balanced_subsample\", random_state=SEED, n_jobs=-1),\n",
        "                   {\"clf__max_depth\": [6, 10, None], \"clf__min_samples_leaf\": [3, 10]}),\n",
        "}\n",
        "fitted, oof, cv_rows, best_params = {}, {}, [], {}\n",
        "for name, (est, grid) in CLF.items():\n",
        "    gs = GridSearchCV(Pipeline([(\"pre\", make_pre()), (\"clf\", est)]), grid, scoring=\"average_precision\", cv=cv, n_jobs=-1, refit=True)\n",
        "    gs.fit(X_train, y_train)\n",
        "    fitted[name] = gs.best_estimator_\n",
        "    best_params[name] = {k.replace(\"clf__\", \"\"): (None if v is None else (float(v) if isinstance(v, float) else v)) for k, v in gs.best_params_.items()}\n",
        "    oof[name] = cross_val_predict(gs.best_estimator_, X_train, y_train, cv=cv, method=\"predict_proba\")[:, 1]\n",
        "    cv_rows.append({\"Model\": name, \"Best hyper-parameters\": str(best_params[name]), \"CV mean AP (grid search)\": gs.best_score_,\n",
        "                    \"OOF ROC-AUC\": roc_auc_score(y_train, oof[name]), \"OOF average precision\": average_precision_score(y_train, oof[name])})\n",
        "cv_df = pd.DataFrame(cv_rows)\n",
        "display(cv_df.round(4))\n",
        "RESULTS[\"best_params\"] = best_params"
      ]
    },
