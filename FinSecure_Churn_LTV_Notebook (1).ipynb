        "score[\"ltv_pred_usd\"] = ltv_pred; score[\"actual_ltv_usd\"] = ltv_test.values\n",
        "ltv_cut = float(ltv_train.median())\n",
        "score[\"high_ltv\"] = score.ltv_pred_usd >= ltv_cut\n",
        "ACTIONS = {(True, True): \"Priority retention intervention (personalised offer + premium support call)\",\n",
        "           (True, False): \"Cost-effective retention (automated nudges, self-service help, low-cost loyalty perk)\",\n",
        "           (False, True): \"Relationship maintenance (customised financial insights, loyalty benefits)\",\n",
        "           (False, False): \"Standard service and periodic monitoring\"}\n",
        "score[\"segment\"] = [ACTIONS[(r == \"High\", h)] for r, h in zip(score.risk_category, score.high_ltv)]\n",
        "score[\"quadrant\"] = [(\"High risk / \" if r == \"High\" else \"Medium-Low risk / \") + (\"High LTV\" if h else \"Low LTV\") for r, h in zip(score.risk_category, score.high_ltv)]\n",
        "quad = score.groupby(\"quadrant\").agg(customers=(\"customer_id\", \"size\"), actual_churn_rate=(\"actual_churned\", \"mean\"), mean_pred_churn_score=(\"churn_probability\", \"mean\"),\n",
        "                                     mean_pred_ltv=(\"ltv_pred_usd\", \"mean\"), mean_actual_ltv=(\"actual_ltv_usd\", \"mean\")).round(3)\n",
        "quad[\"suggested_action\"] = [score.loc[score.quadrant == q, \"segment\"].iloc[0] for q in quad.index]\n",
        "display(quad); RESULTS[\"ltv_cut\"] = ltv_cut\n",
        "RESULTS[\"quadrants\"] = quad.reset_index().to_dict(\"records\")\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(7.2, 4.8))\n",
        "for s in [\"Retained\", \"Churned\"]:\n",
        "    m = score.actual_churned == (1 if s == \"Churned\" else 0); ax.scatter(score.churn_probability[m], score.ltv_pred_usd[m], s=14, alpha=.55, color=PAL[s], label=f\"Actual: {s}\")\n",
        "ax.axvline(t_high, color=\"k\", ls=\"--\", lw=1); ax.axhline(ltv_cut, color=\"k\", ls=\":\", lw=1)\n",
        "ymax = score.ltv_pred_usd.max(); ax.text(t_high + .01, ymax * .97, \"High risk\\nHigh LTV\\n(priority)\", fontsize=8, va=\"top\", fontweight=\"bold\")\n",
        "ax.set_xlabel(\"Predicted churn score\"); ax.set_ylabel(\"Predicted 12-month LTV (USD)\"); ax.set_title(\"Churn risk vs predicted LTV (test customers)\"); ax.legend(fontsize=8, loc=\"center right\")\n",
        "savefig(\"fig12_churn_ltv_matrix\")"
