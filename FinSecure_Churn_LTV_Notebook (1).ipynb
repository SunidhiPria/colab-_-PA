      "source": [
        "kf = KFold(n_splits=5, shuffle=True, random_state=SEED)\n",
        "REG = {\n",
        " \"Ridge Regression\": (Ridge(random_state=SEED), {\"reg__alpha\": [0.01, 0.1, 1, 10, 100]}),\n",
        " \"Random Forest Regressor\": (RandomForestRegressor(n_estimators=300, random_state=SEED, n_jobs=-1),\n",
        "                             {\"reg__max_depth\": [6, 10, None], \"reg__min_samples_leaf\": [3, 10]}),\n",
        "}\n",
        "reg_fit, reg_rows, reg_best = {}, [], {}\n",
        "for name, (est, grid) in REG.items():\n",
        "    gs = GridSearchCV(Pipeline([(\"pre\", make_pre()), (\"reg\", est)]), grid, scoring=\"neg_root_mean_squared_error\", cv=kf, n_jobs=-1, refit=True)\n",
        "    gs.fit(X_train, ltv_train); reg_fit[name] = gs.best_estimator_\n",
        "    reg_best[name] = {k.replace(\"reg__\", \"\"): v for k, v in gs.best_params_.items()}\n",
        "    pr = gs.best_estimator_.predict(X_test)\n",
        "    reg_rows.append({\"Model\": name, \"Best hyper-parameters\": str(reg_best[name]), \"CV RMSE (train)\": -gs.best_score_,\n",
        "                     \"Test MAE (USD)\": mean_absolute_error(ltv_test, pr), \"Test RMSE (USD)\": math.sqrt(mean_squared_error(ltv_test, pr)),\n",
        "                     \"Test R2\": r2_score(ltv_test, pr)})\n",
        "base = Pipeline([(\"pre\", make_pre()), (\"reg\", DummyRegressor(strategy=\"mean\"))]).fit(X_train, ltv_train); pb = base.predict(X_test)\n",
        "reg_rows.append({\"Model\": \"Baseline (training mean)\", \"Best hyper-parameters\": \"-\", \"CV RMSE (train)\": np.nan,\n",
        "                 \"Test MAE (USD)\": mean_absolute_error(ltv_test, pb), \"Test RMSE (USD)\": math.sqrt(mean_squared_error(ltv_test, pb)), \"Test R2\": r2_score(ltv_test, pb)})\n",
        "reg_df = pd.DataFrame(reg_rows)\n",
        "BEST_REG = reg_df[reg_df.Model.isin(REG)].sort_values(\"CV RMSE (train)\").iloc[0][\"Model\"]   # selected on CV only\n",
        "display(reg_df.round(3)); print(\"Selected regressor (lowest CV RMSE on training data):\", BEST_REG)\n",
        "reg_df.round(3).to_csv(os.path.join(OUT, \"ltv_results.csv\"), index=False)\n",
        "RESULTS[\"reg_table\"] = reg_df.round(3).where(reg_df.notna(), None).to_dict(\"records\"); RESULTS[\"selected_regressor\"] = BEST_REG\n",
        "RESULTS[\"reg_best\"] = {k: {a: (None if b is None else b) for a, b in v.items()} for k, v in reg_best.items()}"
      ]
