        "    pr_, rc_, _ = precision_recall_curve(y_test, test_proba[n]); ax[1].plot(rc_, pr_, color=cols[n], lw=2, label=f\"{n} (AP = {average_precision_score(y_test, test_proba[n]):.3f})\")\n",
