        "# hypothetical targeting scenario\n",
        "sc = score.join(df.loc[X_test.index, [\"tenure_months\", \"historical_revenue_usd\"]])\n",
        "sc[\"run_rate\"] = sc.historical_revenue_usd / sc.tenure_months\n",
        "sc[\"stake\"] = 12 * sc.run_rate                      # revenue at stake over 12 months if the customer is retained\n",
        "K = int(math.ceil(0.20 * len(sc))); COST = 12.0\n",
        "strat = {\"A: top 20% by churn score\": sc.sort_values(\"churn_probability\", ascending=False).head(K),\n",
        "         \"B: top 20% by churn score x revenue at stake\": sc.assign(ev=sc.churn_probability * sc.stake).sort_values(\"ev\", ascending=False).head(K)}\n",
        "rows = []\n",
        "for nm, t in strat.items():\n",
        "    real = float((t.actual_churned * t.stake).sum())\n",
        "    rows.append({\"Targeting rule\": nm, \"Customers contacted\": K, \"Actual churners reached\": int(t.actual_churned.sum()),\n",
        "                 \"Realised revenue at stake (USD)\": real, **{f\"Net benefit s={s:.0%} (USD)\": s * real - COST * K for s in [0.05, 0.10, 0.15, 0.20]},\n",
        "                 \"Break-even save rate\": COST * K / real})\n",
        "rand_real = float((sc.actual_churned * sc.stake).sum()) * K / len(sc)\n",
        "rows.append({\"Targeting rule\": \"C: random 20% (expected)\", \"Customers contacted\": K, \"Actual churners reached\": round(sc.actual_churned.sum() * K / len(sc), 1),\n",
        "             \"Realised revenue at stake (USD)\": rand_real, **{f\"Net benefit s={s:.0%} (USD)\": s * rand_real - COST * K for s in [0.05, 0.10, 0.15, 0.20]},\n",
        "             \"Break-even save rate\": COST * K / rand_real})\n",
        "roi = pd.DataFrame(rows); display(roi.round(2)); roi.round(3).to_csv(os.path.join(OUT, \"retention_scenario_results.csv\"), index=False)\n",
        "RESULTS[\"roi\"] = roi.round(3).to_dict(\"records\"); RESULTS[\"roi_assumptions\"] = {\"cost_per_contact\": COST, \"K\": K, \"share\": 0.20}\n",
        "RESULTS[\"stake_mean\"] = float(sc.stake.mean())\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6.5, 3.8))\n",
        "vals = roi[\"Net benefit s=15% (USD)\"]; ax.bar([\"A: churn score\\nonly\", \"B: score x revenue\\nat stake\", \"C: random\\n(expected)\"], vals, color=[COL_RET, \"#009E73\", \"#999999\"], width=.55)\n",
        "for i, v in enumerate(vals): ax.text(i, v + (20 if v >= 0 else -75), f\"USD {v:,.0f}\", ha=\"center\", fontsize=9)\n",
        "ax.axhline(0, color=\"k\", lw=0.8)\n",
        "ax.set_ylabel(\"Hypothetical net benefit (USD)\"); ax.set_title(\"Scenario: net benefit, assumed 15% save rate, USD 12 per contact\\n(hypothetical, not measured)\", fontsize=10)\n",
        "ax.set_ylim(min(0, vals.min()) * 1.5, vals.max() * 1.2); savefig(\"fig13_targeting_scenario\")"
      ]
    },
