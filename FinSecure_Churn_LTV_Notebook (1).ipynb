        "def _clean(o):                       # make JSON strictly valid: NaN -> null, numpy scalars -> Python\n",
        "    if isinstance(o, dict): return {str(k): _clean(v) for k, v in o.items()}\n",
        "    if isinstance(o, (list, tuple)): return [_clean(v) for v in o]\n",
        "    if hasattr(o, \"item\"): o = o.item()\n",
        "    if isinstance(o, float) and math.isnan(o): return None\n",
        "    return o\n",
        "with open(os.path.join(OUT, \"results.json\"), \"w\") as f: json.dump(_clean(RESULTS), f, indent=2, allow_nan=False)\n",
