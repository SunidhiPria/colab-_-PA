        "imp = pd.DataFrame({\"feature\": X_test.columns, \"mean\": pi.importances_mean, \"std\": pi.importances_std}).sort_values(\"mean\", ascending=False)\n",
        "top = imp.head(10).iloc[::-1]\n",
        "fig, ax = plt.subplots(figsize=(6.5, 4.2))\n",
        "ax.barh(top[\"feature\"], top[\"mean\"], xerr=top[\"std\"], color=COL_RET, capsize=3)\n",
        "ax.set_xlabel(\"Decrease in average precision when feature is shuffled\"); ax.set_title(f\"Permutation importance - {BEST}\")\n",
        "savefig(\"fig09_permutation_importance\")\n",
        "display(imp.round(4)); imp.round(4).to_csv(os.path.join(OUT, \"permutation_importance.csv\"), index=False)\n",
        "RESULTS[\"importance\"] = imp.head(10).round(4).to_dict(\"records\")"
      ]
