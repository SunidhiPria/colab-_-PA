      "source": [
        "print(\"Data types after cleaning:\"); display(df.dtypes.to_frame(\"dtype\").T)\n",
        "num_cols_all = [\"tenure_months\", \"transactions_per_month\", \"app_logins_per_month\", \"support_tickets_90d\", \"late_payments_6m\",\n",
        "                \"failed_payments_6m\", \"investment_balance_usd\", \"prev_cancellations\", \"effective_monthly_fee_usd\",\n",
        "                \"historical_revenue_usd\", \"ltv_12m_usd\"]\n",
        "desc = df[num_cols_all].describe().T\n",
        "desc[\"missing\"] = df[num_cols_all].isna().sum()\n",
        "display(desc.round(2))\n",
        "desc.round(3).to_csv(os.path.join(OUT, \"descriptive_statistics.csv\"))\n",
        "\n",
        "# outlier investigation (IQR rule) - flagged, NOT removed: heavy tails here are genuine (e.g. investment balances)\n",
        "rows = []\n",
        "for c in [\"app_logins_per_month\", \"transactions_per_month\", \"investment_balance_usd\", \"historical_revenue_usd\", \"ltv_12m_usd\"]:\n",
        "    s = df[c].dropna(); q1, q3 = s.quantile([.25, .75]); iqr = q3 - q1\n",
        "    n_out = int(((s < q1 - 1.5 * iqr) | (s > q3 + 1.5 * iqr)).sum())\n",
        "    rows.append((c, n_out, round(100 * n_out / len(s), 2), round(s.skew(), 2)))\n",
        "outlier_tbl = pd.DataFrame(rows, columns=[\"variable\", \"n_IQR_outliers\", \"pct\", \"skewness\"])\n",
        "display(outlier_tbl)\n",
        "RESULTS[\"outlier_table\"] = rows"
      ]
    },
