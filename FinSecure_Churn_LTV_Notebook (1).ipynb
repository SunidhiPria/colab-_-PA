        "def make_raw_messy(clean, seed=42):\n",
        "    rng = np.random.default_rng(seed + 1)\n",
        "    raw = clean.copy()\n",
        "    n = len(raw)\n",
        "    pick = lambda options, probs: rng.choice(options, p=probs)\n",
        "\n",
        "    # inconsistent label / category formats\n",
        "    raw[\"churned\"] = [pick([\"Churned\", \"churned\", \"CHURNED\", \"Cancelled\"], [.7, .1, .1, .1]) if v == 1\n",
        "                      else pick([\"Retained\", \"retained\", \"Active\"], [.8, .1, .1]) for v in clean[\"churned\"]]\n",
        "    raw[\"investment_active\"] = [pick([\"Yes\", \"yes\", \"Y\", \"1\"], [.6, .15, .15, .1]) if v == 1\n",
        "                                else pick([\"No\", \"no\", \"N\", \"0\"], [.6, .15, .15, .1]) for v in clean[\"investment_active\"]]\n",
        "    def promo_var(x):\n",
        "        if x == \"None\":\n",
        "            return pick([\"None\", \"none\", \"NONE\", \"No Offer\"], [.85, .05, .05, .05])\n",
        "        return pick([x, x.lower(), \" \" + x + \" \", x.upper()], [.88, .04, .04, .04])\n",
        "    raw[\"promo_offer\"] = [promo_var(x) for x in clean[\"promo_offer\"]]\n",
        "    def age_var(x):\n",
        "        if rng.random() < 0.06:\n",
        "            return {\"18-24\": \"18 to 24\", \"25-34\": \"25 - 34\", \"35-44\": \"35 to 44\", \"45-54\": \"45 - 54\", \"55+\": \"55 plus\"}[x]\n",
        "        return x\n",
        "    raw[\"age_group\"] = [age_var(x) for x in clean[\"age_group\"]]\n",
        "    raw[\"income_range\"] = [(\"$\" + x.replace(\"-\", \"-$\")) if (rng.random() < 0.04 and x[0].isdigit()) else x for x in clean[\"income_range\"]]\n",
        "    raw[\"tenure_months\"] = [f\"{t} months\" if rng.random() < 0.015 else t for t in clean[\"tenure_months\"]]\n",
        "    raw[\"tenure_months\"] = raw[\"tenure_months\"].astype(object)\n",
        "\n",
        "    # missing values\n",
        "    for col, frac in [(\"age_group\", .02), (\"income_range\", .04), (\"app_logins_per_month\", .03),\n",
        "                      (\"transactions_per_month\", .03), (\"support_tickets_90d\", .02), (\"late_payments_6m\", .02)]:\n",
        "        raw[col] = raw[col].astype(object) if col in (\"age_group\", \"income_range\") else raw[col].astype(float)\n",
        "        raw.loc[rng.random(n) < frac, col] = np.nan\n",
        "    act = np.where(clean[\"investment_active\"].to_numpy() == 1)[0]\n",
        "    raw.loc[raw.index[act[rng.random(len(act)) < 0.02]], \"investment_balance_usd\"] = np.nan\n",
        "\n",
        "    # implausible entries (looks like data-entry errors: > 150 logins per month)\n",
        "    bad = rng.choice(n, 6, replace=False)\n",
        "    raw.loc[raw.index[bad], \"app_logins_per_month\"] = [180, 240, 310, 420, 195, 260]\n",
        "\n",
        "    # duplicates: 45 exact copies + 15 copies differing only in text formatting\n",
        "    exact = raw.sample(45, random_state=SEED)\n",
        "    fmt = raw.sample(15, random_state=SEED + 7).copy()\n",
        "    fmt[\"promo_offer\"] = fmt[\"promo_offer\"].astype(str).str.strip().str.upper()\n",
        "    fmt[\"churned\"] = fmt[\"churned\"].astype(str).str.upper()\n",
        "    raw = pd.concat([raw, exact, fmt], ignore_index=True).sample(frac=1, random_state=SEED).reset_index(drop=True)\n",
        "    return raw\n",
        "\n",
        "raw = make_raw_messy(truth, SEED)\n",
        "raw.to_csv(os.path.join(OUT, \"finsecure_raw_messy_dataset.csv\"), index=False)\n",
        "print(\"Raw table:\", raw.shape)\n",
        "display(raw.head())"
      ]
    },
