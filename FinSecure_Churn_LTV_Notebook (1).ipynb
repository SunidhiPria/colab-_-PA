        "t_high = thr[BEST]; t_low = round(t_high / 2, 3)\n",
        "score = pd.DataFrame({\"customer_id\": df.loc[X_test.index, \"customer_id\"].values, \"churn_probability\": test_proba[BEST],\n",
        "                      \"actual_churned\": y_test.values}, index=X_test.index)\n",
        "score[\"risk_category\"] = np.where(score.churn_probability >= t_high, \"High\", np.where(score.churn_probability >= t_low, \"Medium\", \"Low\"))\n",
        "score[\"predicted_churn_flag\"] = (score.churn_probability >= t_high).astype(int)\n",
        "tier = score.groupby(\"risk_category\").agg(customers=(\"actual_churned\", \"size\"), actual_churn_rate=(\"actual_churned\", \"mean\"),\n",
        "                                          mean_probability=(\"churn_probability\", \"mean\")).reindex([\"High\", \"Medium\", \"Low\"])\n",
        "display(tier.round(3))\n",
        "RESULTS[\"tiers\"] = {k: {\"n\": int(r.customers), \"churn_rate\": float(r.actual_churn_rate), \"mean_p\": float(r.mean_probability)} for k, r in tier.iterrows()}\n",
        "RESULTS[\"tier_thresholds\"] = {\"high\": t_high, \"low\": t_low}\n",
        "RESULTS[\"tier_churners_captured_high\"] = int(score.query(\"risk_category=='High'\").actual_churned.sum())\n",
        "print(\"Churners in test set:\", int(y_test.sum()), \"| captured in High tier:\", RESULTS[\"tier_churners_captured_high\"])\n",
        "\n",
        "fig, ax = plt.subplots(1, 2, figsize=(10, 3.8))\n",
        "for s, lab in [(0, \"Retained\"), (1, \"Churned\")]:\n",
        "    ax[0].hist(score.loc[score.actual_churned == s, \"churn_probability\"], bins=25, alpha=.7, color=PAL[lab], label=lab)\n",
        "ax[0].axvline(t_high, color=\"k\", ls=\"--\", lw=1.2, label=f\"High-risk cut-off ({t_high:.2f})\"); ax[0].axvline(t_low, color=\"grey\", ls=\":\", lw=1.2, label=f\"Low-risk cut-off ({t_low:.3f}, illustrative)\")\n",
        "ax[0].set_xlabel(\"Predicted churn score\"); ax[0].set_ylabel(\"Number of test customers\"); ax[0].set_title(\"Churn score distribution (test set)\"); ax[0].legend(fontsize=7.5)\n",
