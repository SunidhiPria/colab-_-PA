      "source": [
        "# Fig 3: churn rate by support tickets, late payments, failed payments (counts capped for readable bins)\n",
        "def capped(s, cap): return s.clip(upper=cap).map(lambda v: f\"{int(v)}+\" if v >= cap else str(int(v)))\n",
        "fig, axes = plt.subplots(1, 3, figsize=(10, 3.8), sharey=True)\n",
        "rate_tables = {}\n",
        "for ax, (c, cap, lab) in zip(axes, [(\"support_tickets_90d\", 4, \"Support tickets (last 90 days)\"),\n",
        "                                    (\"late_payments_6m\", 3, \"Late payments (last 6 months)\"),\n",
        "                                    (\"failed_payments_6m\", 2, \"Failed payments (last 6 months)\")]):\n",
        "    tmp = df.dropna(subset=[c]).copy(); tmp[\"bin\"] = capped(tmp[c], cap)\n",
        "    order = [str(i) for i in range(cap)] + [f\"{cap}+\"]\n",
        "    g = tmp.groupby(\"bin\")[\"churned\"].agg([\"mean\", \"size\"]).reindex(order)\n",
        "    rate_tables[c] = g\n",
        "    ax.bar(g.index, g[\"mean\"] * 100, color=COL_CHN, width=0.6)\n",
        "    for i, (m, n_) in enumerate(zip(g[\"mean\"], g[\"size\"])):\n",
        "        ax.text(i, m * 100 + 1, f\"n={n_}\", ha=\"center\", fontsize=7.5)\n",
        "    ax.axhline(df.churned.mean() * 100, color=\"k\", ls=\"--\", lw=1, label=\"Overall rate\")\n",
        "    ax.set_xlabel(lab); ax.set_title(\"Churn rate by \" + lab.split(\" (\")[0].lower())\n",
        "axes[0].set_ylabel(\"Churn rate (%)\"); axes[0].legend(fontsize=8, loc=\"upper left\")\n",
        "savefig(\"fig03_service_payment_vs_churn\")\n",
        "RESULTS[\"rate_tables\"] = {k: {str(i): [float(r[\"mean\"]), int(r[\"size\"])] for i, r in v.iterrows()} for k, v in rate_tables.items()}"
      ]
    },
